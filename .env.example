# DropIn environment variables — NAMES ONLY. No real value belongs in this
# file, ever; it exists purely to document what a real .env.local (or a
# Vercel/GitHub Actions environment-variable configuration) needs to
# contain. See docs/PHASE_5B2B_R2_STORAGE_INTEGRATION.md for the full
# explanation of what each one is for and which context uses it.
#
# Copy this file to .env.local (already gitignored) and fill in real
# values there for local integration testing — never here.

# Set to "r2" to read/write Cloudflare R2 instead of the local
# data/ directory. Leave unset (or any other value) for local development —
# this is the default and requires nothing below.
SNAPSHOT_STORAGE=

# Shared by both the application (Vercel) and the refresh pipeline
# (GitHub Actions). Not secret in the same sense as a key, but still
# configuration, not something to broadcast unnecessarily.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=

# Application / Vercel — read-only credential (Credential A, Phase 5B-2A).
# Used only by the deployed app's own read path. SECRET.
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=

# Refresh pipeline / GitHub Actions only — read+write credential
# (Credential B, Phase 5B-2A). Never belongs in Vercel. SECRET.
R2_WRITE_ACCESS_KEY_ID=
R2_WRITE_SECRET_ACCESS_KEY=

# Optional. Only set on a specific Preview deployment (branch-scoped, not
# global) that's reviewing a not-yet-approved new municipality — see
# docs/PHASE_5A_HOSTING_REFRESH_ARCHITECTURE.md §14. Any other value, or
# leaving this unset, means "production" — the correct default for both
# the live production deployment and every ordinary preview.
R2_KEY_PREFIX=
